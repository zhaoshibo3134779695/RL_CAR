#!/usr/bin/python3
import argparse
import json
from pathlib import Path

import cv2
from raicom_research_assets.perception import TrackAnalysis, competition_profile


def main():
    parser = argparse.ArgumentParser(description='Process an original-resolution competition camera frame.')
    parser.add_argument('image', type=Path)
    parser.add_argument('output', type=Path, help='Output directory for PNGs and measurements')
    parser.add_argument('--config', type=Path, default=competition_profile())
    args = parser.parse_args()
    image = cv2.imread(str(args.image))
    if image is None:
        parser.error(f'Cannot decode {args.image}')
    try:
        images, stats = TrackAnalysis(args.config).analyze(image, 0.0)
    except ValueError as exc:
        parser.error(str(exc))
    args.output.mkdir(parents=True, exist_ok=True)
    for name, view in images.items():
        if not cv2.imwrite(str(args.output / f'{name}.png'), view):
            raise OSError(f'Could not write {name}')
    stats['input'] = str(args.image)
    stats['profile'] = str(args.config)
    output = json.dumps(stats, indent=2, ensure_ascii=False)
    (args.output / 'measurements.json').write_text(output + '\n')
    print(output)


if __name__ == '__main__':
    main()
