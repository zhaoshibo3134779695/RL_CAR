<?xml version="1.0"?>
<sdf version="1.10" xmlns:gz="http://gazebosim.org/schema">
  <world name="raicom_research">
    <scene>
      <ambient>0.64 0.64 0.64 1</ambient>
      <background>0.22 0.26 0.30 1</background>
      <grid>false</grid>
    </scene>
    <gz:policies>
      <include_gui_default_plugins>false</include_gui_default_plugins>
    </gz:policies>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>-0.035 -1.78 4.15 0 1.15889531 1.57079632679</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right" />
            <line own="top" target="top" />
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>

          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left" />
            <line own="bottom" target="bottom" />
          </anchors>
        </gz-gui>

        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>

      </plugin>
    </gui>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <direction>-0.45 0.35 -1</direction>
      <diffuse>0.85 0.83 0.80 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="competition_map_727best">
      <static>true</static>
      <!-- The image is 978 by 799 pixels. Scale and lower-left corner are from 727best_map.yaml. -->
      <pose>-0.035489 0.024455 0 0 0 0</pose>
      <link name="floor">
        <visual name="occupancy_map">
          <geometry><plane><normal>0 0 1</normal><size>4.89 3.995</size></plane></geometry>
          <material><ambient>0.82 0.82 0.81 1</ambient><diffuse>0.85 0.85 0.83 1</diffuse></material>
        </visual>
        <collision name="floor_surface">
          <geometry><plane><normal>0 0 1</normal><size>4.89 3.995</size></plane></geometry>
        </collision>
      </link>
    </model>
    <model name="walls_727best">
      <static>true</static>
      <link name="walls">
        <visual name="wall_surfaces">
          <geometry><mesh><uri>model://raicom_research_assets/worlds/727best_walls.stl</uri></mesh></geometry>
          <material>
            <ambient>0.18 0.18 0.18 1</ambient><diffuse>0.24 0.24 0.24 1</diffuse>
            <specular>0.035 0.035 0.035 1</specular>
          </material>
        </visual>
        <!-- map_walls.py inserts collision boxes covering the occupied cells here. -->
      </link>
    </model>
    <model name="mowen">
      <static>true</static>
      <pose>-2.21 1.72 0.00053 0 0 -1.5707963267948966</pose>
      <link name="base_link">
        <visual name="vehicle">
          <geometry><mesh><uri>model://mowen/meshes/base_link.STL</uri></mesh></geometry>
          <material>
            <ambient>0.22 0.30 0.38 1</ambient><diffuse>0.38 0.49 0.59 1</diffuse>
            <specular>0.16 0.16 0.16 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
