<launch>
  <!--
    One-command experiment for Sebastian Stage-1 perception plus the isolated
    direct path follower. Sebastian remains motion-disabled; only the remapped
    direct chassis listener can consume this launch's physical commands.
  -->
  <arg name="enable_motion" default="false"/>
  <arg name="auto_start" default="false"/>
  <arg name="start_rviz" default="true"/>
  <arg name="start_perception_view" default="true"/>
  <arg name="startup_timeout_sec" default="90.0"/>
  <arg name="navigation_timeout_sec" default="120.0"/>
  <!-- Far terminal faces are sparse at the region-4 start pose.  Accumulate
       a longer rolling window so one weak 30-scan sample does not delay the
       direct mission for repeated retries. -->
  <arg name="scan_frame_count" default="40"/>
  <arg name="scan_retry_overlap_frames" default="30"/>
  <arg name="disc_collection_window_sec" default="2.0"/>
  <!-- Costmap-only rail extensions keep GlobalPlanner inside the observed
       corridor.  The measured boundary payload used for disc gaps is not
       extended. -->
  <arg name="corridor_costmap_extension_before_m" default="0.55"/>
  <arg name="corridor_costmap_extension_after_m" default="0.75"/>

  <arg name="max_linear_mps" default="0.324"/>
  <arg name="terminal_max_linear_mps" default="0.42"/>
  <arg name="max_angular_radps" default="0.18"/>
  <arg name="lookahead_m" default="0.18"/>
  <arg name="maximum_cross_track_error_m" default="0.08"/>
  <arg name="minimum_disc_clearance_m" default="0.005"/>
  <arg name="stop_on_disc_clearance_violation" default="false"/>
  <arg name="minimum_confirmed_disc_count" default="2"/>
  <arg name="final_lateral_offset_m" default="0.035"/>
  <arg name="final_offset_blend_distance_m" default="0.30"/>
  <arg name="extend_to_terminal_marker" default="true"/>
  <arg name="terminal_forward_offset_m" default="0.35"/>

  <include file="$(find yellow_track_avoidance)/launch/competition_stage1_auto.launch">
    <!-- Keep move_base and the original TEB physically disconnected. -->
    <arg name="enable_motion" value="false"/>
    <arg name="use_shadow_odometry" value="false"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="start_perception_view" value="$(arg start_perception_view)"/>
    <arg name="startup_timeout_sec" value="$(arg startup_timeout_sec)"/>
    <arg name="navigation_timeout_sec" value="$(arg navigation_timeout_sec)"/>
    <arg name="scan_frame_count" value="$(arg scan_frame_count)"/>
    <arg name="scan_retry_overlap_frames"
         value="$(arg scan_retry_overlap_frames)"/>
  </include>

  <!-- Competition-only visual robustness. The base Sebastian profile remains
       untouched; these overrides apply only through this nav_demo wrapper. -->
  <param name="/yellow_track_avoidance/config_file"
         value="$(find nav_demo)/config/region4_competition_20260819.yaml"/>
  <rosparam param="/yellow_track_v4l2_controls/exposure_candidates">
    [30, 40, 50, 56, 60]
  </rosparam>
  <param name="/yellow_track_v4l2_controls/white_balance_warmup_sec"
         type="double" value="3.0"/>
  <param name="/yellow_track_v4l2_controls/exposure_settle_sec"
         type="double" value="0.45"/>
  <param name="/yellow_track_v4l2_controls/exposure_evaluate_sec"
         type="double" value="1.0"/>

  <param name="/yellow_track_competition_corridor_map/costmap_extension_before_m"
         value="$(arg corridor_costmap_extension_before_m)"/>
  <param name="/yellow_track_competition_corridor_map/costmap_extension_after_m"
         value="$(arg corridor_costmap_extension_after_m)"/>
  <param name="/yellow_track_avoidance/perception_lock_stable_sec"
         value="$(arg disc_collection_window_sec)"/>

  <node if="$(arg enable_motion)"
        pkg="car_bringup" type="newt.py"
        name="direct_cmd_vel_listener" output="screen" required="true">
    <remap from="/cmd_vel" to="/cmd_vel_stage1_direct"/>
  </node>

  <node pkg="nav_demo" type="stage1_direct_path_follower.py"
        name="stage1_direct_path_follower" output="screen" required="true">
    <param name="enable_motion" value="$(arg enable_motion)"/>
    <param name="auto_start" value="$(arg auto_start)"/>
    <param name="command_topic" value="/cmd_vel_stage1_direct"/>
    <param name="required_command_subscriber"
           value="/direct_cmd_vel_listener"/>
    <param name="max_linear_mps" value="$(arg max_linear_mps)"/>
    <param name="terminal_max_linear_mps"
           value="$(arg terminal_max_linear_mps)"/>
    <param name="max_angular_radps" value="$(arg max_angular_radps)"/>
    <param name="lookahead_m" value="$(arg lookahead_m)"/>
    <param name="maximum_cross_track_error_m"
           value="$(arg maximum_cross_track_error_m)"/>
    <param name="minimum_disc_clearance_m"
           value="$(arg minimum_disc_clearance_m)"/>
    <param name="stop_on_disc_clearance_violation"
           value="$(arg stop_on_disc_clearance_violation)"/>
    <param name="minimum_confirmed_disc_count"
           value="$(arg minimum_confirmed_disc_count)"/>
    <param name="final_lateral_offset_m"
           value="$(arg final_lateral_offset_m)"/>
    <param name="final_offset_blend_distance_m"
           value="$(arg final_offset_blend_distance_m)"/>
    <param name="extend_to_terminal_marker"
           value="$(arg extend_to_terminal_marker)"/>
    <param name="terminal_forward_offset_m"
           value="$(arg terminal_forward_offset_m)"/>
  </node>
</launch>
