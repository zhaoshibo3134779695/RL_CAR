<launch>
    <arg name="map" default="727best_map.yaml" />
    <arg name="rviz" default="true" />
    <arg name="rviz_config" default="$(find nav_demo)/config/single_nav.rviz" />
    <arg name="laser_yaw" default="3.14159" />
    <arg name="mesh_yaw" default="0.0" />
    <arg name="initial_pose_x" default="0.0" />
    <arg name="initial_pose_y" default="0.0" />
    <arg name="initial_pose_a" default="0.0" />
    <arg name="ekf_params" default="$(find car_bringup)/param/robot_localization_nav.yaml" />

    <param name="use_sim_time" value="false" />

    <include file="$(find nav_demo)/launch/nav03_map_server.launch">
        <arg name="map" value="$(arg map)" />
    </include>

    <include file="$(find lslidar_driver)/launch/lslidar_serial.launch">
        <arg name="laser_yaw" value="$(arg laser_yaw)" />
    </include>
    <include file="$(find mowen)/launch/display.launch">
        <arg name="mesh_yaw" value="$(arg mesh_yaw)" />
    </include>
    <include file="$(find yesense_imu)/launch/yesense_ahrs.launch" />

    <node pkg="car_bringup" name="pubv" type="pubv.py" />

    <node pkg="car_bringup" type="base_node" name="odometry_publisher">
        <param name="odom_frame" type="string" value="odom" />
        <param name="base_footprint_frame" type="string" value="base_footprint" />
        <param name="linear_scale_x" type="double" value="1.0" />
        <param name="linear_scale_y" type="double" value="1.0" />
        <param name="max_vel_dt" type="double" value="0.5" />
        <remap from="/sub_vel" to="/vel_raw" />
        <remap from="/pub_odom" to="/odom_raw" />
    </node>

    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization" output="screen">
        <remap from="odometry/filtered" to="odom" />
        <remap from="/odom0" to="odom_raw" />
        <param name="odom_frame" value="odom" />
        <param name="world_frame" value="odom" />
        <param name="base_link_frame" value="base_footprint" />
        <rosparam command="load" file="$(arg ekf_params)" />
    </node>

    <include file="$(find nav_demo)/launch/nav04_amcl_tuned.launch">
        <arg name="initial_pose_x" value="$(arg initial_pose_x)" />
        <arg name="initial_pose_y" value="$(arg initial_pose_y)" />
        <arg name="initial_pose_a" value="$(arg initial_pose_a)" />
    </include>

    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)" />
</launch>
