Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
        - /Lidar Scan1
        - /Global Costmap1
        - /Local Costmap1
        - /Stage 2 Lidar Goal1
        - /GlobalPlanner Path1
        - /TEB Local Path1
      Splitter Ratio: 0.55
    Tree Height: 600
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.45
      Cell Size: 0.5
      Class: rviz/Grid
      Color: 120; 120; 125
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 16
      Reference Frame: map
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0.1
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 0; 0
      Min Color: 255; 0; 0
      Name: Lidar Scan
      Position Transformer: XYZ
      Queue Size: 20
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.025
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.55
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 0.35
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /yellow_track_avoidance/stage2_frozen_scene_markers
      Name: Frozen Stage 2 Walls
      Queue Size: 1
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /yellow_track_avoidance/stage2_lidar_goal_markers
      Name: Stage 2 Lidar Goal
      Queue Size: 10
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 40; 210
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.15
      Line Style: Lines
      Line Width: 0.045
      Name: Stage 2 Goal Preview
      Offset:
        X: 0
        Y: 0
        Z: 0.065
      Pose Color: 255; 40; 210
      Pose Style: None
      Queue Size: 1
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.05
      Topic: /yellow_track_avoidance/stage2_lidar_goal_plan
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 20; 210; 70
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.15
      Line Style: Lines
      Line Width: 0.04
      Name: GlobalPlanner Path
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Color: 20; 210; 70
      Pose Style: None
      Queue Size: 5
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.05
      Topic: /move_base/GlobalPlanner/plan
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 90; 20
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.15
      Line Style: Lines
      Line Width: 0.05
      Name: TEB Local Path
      Offset:
        X: 0
        Y: 0
        Z: 0.07
      Pose Color: 255; 90; 20
      Pose Style: None
      Queue Size: 5
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.05
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: Robot
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Class: rviz/Polygon
      Color: 0; 80; 255
      Enabled: true
      Name: Robot Footprint
      Queue Size: 10
      Topic: /move_base/local_costmap/footprint
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 245; 245; 245
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 240
      Target Frame: map
      X: 1.25
      Y: -0.05
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 760
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1220
  X: 40
  Y: 20
