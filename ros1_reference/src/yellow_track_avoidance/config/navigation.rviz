Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
        - /Detected Discs1
        - /Global Plan1
        - /Local Plan1
      Splitter Ratio: 0.550000011920929
    Tree Height: 385
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Lidar
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.029999999329447746
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /yellow_track_avoidance/disc_markers
      Name: Detected Discs
      Namespaces:
        yellow_track_disc_center: true
        yellow_track_disc_outer: true
      Queue Size: 20
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /yellow_track_avoidance/passage/markers
      Name: Passage Supervisor
      Namespaces:
        passage_gate: true
        passage_obstacles: true
        passage_reference: true
        passage_state: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /yellow_track_avoidance/corridor_markers
      Name: Live Yellow Corridor
      Namespaces:
        corridor_goal_offset: false
        corridor_goal_reference: false
        corridor_goal_vehicle: false
        corridor_centerline: true
        left_yellow_live: true
        right_yellow_inferred: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /yellow_track_avoidance/stage1_lidar_goal_markers
      Name: Stage 1 Lidar Goal
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /yellow_track_avoidance/passage_closure_markers
      Name: Disc Gap Decisions
      Namespaces:
        blocked_disc_line_gap: true
        disc_gap_decision: true
      Queue Size: 10
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 40; 210
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.15
      Line Style: Lines
      Line Width: 0.045
      Name: Stage 1 Goal Preview
      Offset:
        X: 0
        Y: 0
        Z: 0.065
      Pose Color: 255; 40; 210
      Pose Style: None
      Queue Size: 1
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.05
      Topic: /yellow_track_avoidance/stage1_lidar_goal_plan
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 230; 255
      Enabled: false
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.15
      Line Style: Lines
      Line Width: 0.025
      Name: Yellow Corridor Centerline
      Offset:
        X: 0
        Y: 0
        Z: 0.045
      Pose Color: 0; 230; 255
      Pose Style: None
      Queue Size: 10
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.05
      Topic: /yellow_track_avoidance/corridor_centerline
      Unreliable: false
      Value: false
