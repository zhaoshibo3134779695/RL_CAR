<launch>
  <!-- Full camera-to-map dry run. All motion remains disabled. -->
  <arg name="map" default="$(find yellow_track_avoidance)/maps/track_7_15_5x4.yaml"/>
  <arg name="route" default="$(find yellow_track_avoidance)/config/track_7_15_route.yaml"/>
  <arg name="config" default="$(find yellow_track_avoidance)/config/calibrated.yaml"/>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>

  <node pkg="map_server" type="map_server" name="yellow_track_map_server"
        output="screen" args="$(arg map)"/>
  <node pkg="yellow_track_avoidance" type="map_route_publisher.py"
        name="yellow_track_map_route" output="screen" required="true">
    <param name="route_file" value="$(arg route)"/>
  </node>
  <node pkg="yellow_track_avoidance" type="yellow_track_avoidance_node.py"
        name="yellow_track_avoidance" output="screen" required="true">
    <param name="config_file" value="$(arg config)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="output_cmd_topic" value="/yellow_track_avoidance/cmd_vel"/>
    <param name="enable_planning" value="true"/>
    <param name="enable_motion" value="false"/>
  </node>
  <node pkg="yellow_track_avoidance" type="map_avoidance_fusion.py"
        name="yellow_track_map_avoidance_fusion" output="screen" required="true">
    <param name="route_file" value="$(arg route)"/>
    <param name="perception_config_file" value="$(arg config)"/>
  </node>
</launch>
