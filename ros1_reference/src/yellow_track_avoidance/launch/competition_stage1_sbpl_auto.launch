<launch>
  <!--
    Locked by default. This mirrors the validated Stage-1 acquisition and
    lidar-goal flow, but substitutes SBPL for GlobalPlanner and requires no
    semantic one-side passage closures. No command reaches the chassis unless
    a future operator explicitly supplies enable_motion:=true.
  -->
  <arg name="enable_motion" default="false"/>
  <arg name="start_rviz" default="true"/>
  <arg name="start_perception_view" default="true"/>
  <arg name="scan_frame_count" default="10"/>
  <arg name="startup_timeout_sec" default="45.0"/>
  <arg name="navigation_timeout_sec" default="120.0"/>
  <arg name="costmap_inflation_radius" default="0.24"/>

  <include file="$(find yellow_track_avoidance)/launch/competition_stage1_sbpl_prepare.launch">
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="start_perception_view" value="$(arg start_perception_view)"/>
    <arg name="start_lidar" value="true"/>
    <arg name="start_chassis" value="$(arg enable_motion)"/>
    <arg name="costmap_inflation_radius"
         value="$(arg costmap_inflation_radius)"/>
  </include>

  <include file="$(find yellow_track_avoidance)/launch/competition_stage1_lidar_goal_capture.launch">
    <arg name="start_lidar_driver" value="false"/>
    <arg name="scan_frame_count" value="$(arg scan_frame_count)"/>
    <arg name="front_clearance_m" value="0.10"/>
    <arg name="require_passage_closures" value="false"/>
  </include>

  <node pkg="yellow_track_avoidance" type="stage1_auto_runner.py"
        name="yellow_track_stage1_auto_runner" output="screen">
    <param name="enable_motion" value="$(arg enable_motion)"/>
    <param name="goal_ready_stable_sec" value="0.30"/>
    <param name="startup_timeout_sec" value="$(arg startup_timeout_sec)"/>
    <param name="navigation_timeout_sec" value="$(arg navigation_timeout_sec)"/>
    <param name="status_timeout_sec" value="2.0"/>
  </node>
</launch>
