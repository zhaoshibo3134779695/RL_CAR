<launch>
  <!-- Use only after calibration, raised-wheel testing, and stopping every other
       /cmd_vel publisher. Runtime publisher exclusivity is checked by the node. -->
  <!-- This profile is intentionally uncalibrated and therefore cannot move.
       Pass a newly calibrated USB-camera profile before physical testing. -->
  <arg name="config" default="$(find yellow_track_avoidance)/config/current_car.yaml"/>
  <arg name="image_topic" default="/usb_cam/image_raw"/>
  <arg name="camera_info_topic" default="/usb_cam/camera_info"/>
  <arg name="output_cmd_topic" default="/cmd_vel"/>
  <arg name="start_camera" default="false"/>
  <arg name="video_device"
       default="/dev/v4l/by-id/usb-Generic_Integrated_Webcam_200901010001-video-index0"/>
  <arg name="start_chassis" default="false"/>

  <include file="$(find yellow_track_avoidance)/launch/current_car_camera.launch">
    <arg name="start_camera" value="$(arg start_camera)"/>
    <arg name="video_device" value="$(arg video_device)"/>
  </include>

  <node if="$(arg start_chassis)"
        pkg="car_bringup" type="newt.py"
        name="yellow_track_chassis_bridge"
        output="screen" required="true"/>

  <node pkg="yellow_track_avoidance"
        type="yellow_track_avoidance_node.py"
        name="yellow_track_avoidance"
        output="screen"
        required="true">
    <param name="config_file" value="$(arg config)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="output_cmd_topic" value="$(arg output_cmd_topic)"/>
    <param name="enable_motion" value="true"/>
  </node>
</launch>
