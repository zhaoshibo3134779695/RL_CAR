<launch>
  <!--
    One-command Stage-1 entrypoint.  Readiness is state-driven: the runner
    sends no goal until the corridor and the three-second disc set are frozen,
    thirty lidar scans form a valid entrance goal, make_plan succeeds, odometry is stationary,
    and the /cmd_vel authority chain is correct.
  -->
  <arg name="enable_motion" default="false"/>
  <!-- Test-only: replace physical wheel/IMU odometry and chassis consumption
       with an ideal software integrator.  The formal default remains false. -->
  <arg name="use_shadow_odometry" default="false"/>
  <arg name="start_rviz" default="true"/>
  <arg name="start_perception_view" default="true"/>
  <!-- Thirty scans robustly fit the long right wall and the two stable far
       terminal faces.  The intermittent entrance end-face return is optional
       diagnostic evidence and no longer gates Stage-1 readiness. -->
  <arg name="scan_frame_count" default="30"/>
  <arg name="scan_retry_overlap_frames" default="20"/>
  <arg name="startup_timeout_sec" default="35.0"/>
  <arg name="navigation_timeout_sec" default="120.0"/>
  <!-- Broad, slowly decaying global preference; minimal local feasibility
       inflation. The global/TEB/local hard disc radii remain independent. -->
  <arg name="costmap_inflation_radius" default="0.24"/>
  <arg name="global_costmap_inflation_radius" default="0.24"/>
  <arg name="local_costmap_inflation_radius" default="0.0"/>
  <arg name="disc_collision_radius_m" default="0.08"/>
  <arg name="teb_disc_collision_radius_m" default="0.09"/>
  <arg name="local_disc_collision_radius_m" default="0.09"/>
  <arg name="costmap_cost_scaling_factor" default="20.0"/>
  <arg name="global_costmap_cost_scaling_factor" default="20.0"/>
  <arg name="local_costmap_cost_scaling_factor" default="70.0"/>
  <arg name="stage1_teb_guard_config"
       default="$(find yellow_track_avoidance)/config/competition_stage1_teb_guard_override.yaml"/>
  <arg name="include_passage_closures_in_teb" default="false"/>

  <include file="$(find yellow_track_avoidance)/launch/competition_stage1_prepare.launch">
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="start_perception_view" value="$(arg start_perception_view)"/>
    <arg name="start_lidar" value="true"/>
    <arg name="start_chassis"
         value="$(eval arg('enable_motion') and not arg('use_shadow_odometry'))"/>
    <arg name="start_imu" value="$(eval not arg('use_shadow_odometry'))"/>
    <arg name="start_odometry" value="$(eval not arg('use_shadow_odometry'))"/>
    <arg name="costmap_inflation_radius"
         value="$(arg costmap_inflation_radius)"/>
    <arg name="disc_collision_radius_m"
         value="$(arg disc_collision_radius_m)"/>
    <arg name="teb_disc_collision_radius_m"
         value="$(arg teb_disc_collision_radius_m)"/>
    <arg name="local_disc_collision_radius_m"
         value="$(arg local_disc_collision_radius_m)"/>
    <arg name="costmap_cost_scaling_factor"
         value="$(arg costmap_cost_scaling_factor)"/>
    <arg name="global_costmap_inflation_radius"
         value="$(arg global_costmap_inflation_radius)"/>
    <arg name="local_costmap_inflation_radius"
         value="$(arg local_costmap_inflation_radius)"/>
    <arg name="global_costmap_cost_scaling_factor"
         value="$(arg global_costmap_cost_scaling_factor)"/>
    <arg name="local_costmap_cost_scaling_factor"
         value="$(arg local_costmap_cost_scaling_factor)"/>
    <arg name="stage1_teb_guard_config"
         value="$(arg stage1_teb_guard_config)"/>
    <arg name="include_passage_closures_in_teb"
         value="$(arg include_passage_closures_in_teb)"/>
  </include>

  <!-- Name the software subscriber cmd_vel_listener so the unchanged
       single-authority topology check can verify exactly one command sink. -->
  <node if="$(arg use_shadow_odometry)"
        pkg="yellow_track_avoidance" type="stage1_shadow_odom.py"
        name="cmd_vel_listener" output="screen" required="true">
    <param name="odom_frame" value="odom"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="cmd_topic" value="/cmd_vel"/>
    <param name="odom_topic" value="/odom"/>
    <param name="rate_hz" value="30.0"/>
    <param name="command_timeout_sec" value="0.35"/>
  </node>

  <include file="$(find yellow_track_avoidance)/launch/competition_stage1_lidar_goal_capture.launch">
    <arg name="start_lidar_driver" value="false"/>
    <arg name="scan_frame_count" value="$(arg scan_frame_count)"/>
    <arg name="scan_retry_overlap_frames"
         value="$(arg scan_retry_overlap_frames)"/>
    <arg name="front_clearance_m" value="0.10"/>
  </include>

  <node pkg="yellow_track_avoidance" type="stage1_auto_runner.py"
        name="yellow_track_stage1_auto_runner" output="screen">
    <param name="enable_motion" value="$(arg enable_motion)"/>
    <param name="goal_ready_stable_sec" value="0.30"/>
    <param name="startup_timeout_sec" value="$(arg startup_timeout_sec)"/>
    <param name="navigation_timeout_sec" value="$(arg navigation_timeout_sec)"/>
    <param name="status_timeout_sec" value="2.0"/>
  </node>
</launch>
