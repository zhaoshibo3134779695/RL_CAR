<launch>
  <!--
    Minimal, single-authority competition planner core.

    This launch intentionally contains no navigation_safety_gate, passage
    supervisor, narrow-gate controller, terminal controller, finish recovery,
    free-interval controller or second local/global planner.  move_base is the
    only /cmd_vel publisher.  Hardware command consumption remains physically
    disconnected while start_chassis=false (the default), and no goal is sent
    automatically.

    Use one of the three small wrapper profiles instead of invoking this file
    directly, so the tested planner pair is unambiguous.
  -->
  <arg name="profile_name"/>
  <arg name="global_planner_plugin"/>
  <arg name="global_planner_config"/>
  <arg name="global_plan_topic"/>
  <arg name="local_planner_plugin"/>
  <arg name="local_planner_config"/>
  <arg name="move_base_config"
       default="$(find yellow_track_avoidance)/config/competition_move_base_no_recovery.yaml"/>
  <arg name="costmap_common_config"
       default="$(find yellow_track_avoidance)/config/click_nav_costmap_common.yaml"/>
  <arg name="global_costmap_observation_sources"
       default="scan yellow_discs yellow_corridor passage_closures"/>
  <arg name="local_costmap_observation_sources"
       default="scan yellow_discs yellow_corridor passage_closures"/>
  <arg name="use_sbpl" default="false"/>
  <arg name="use_teb" default="false"/>
  <arg name="use_compact_teb_obstacles" default="false"/>
  <arg name="enable_stage1_passage_closures" default="false"/>
  <arg name="include_passage_closures_in_teb" default="true"/>
  <arg name="publish_sbpl_full_disc_cloud" default="false"/>
  <arg name="costmap_inflation_radius" default="0.24"/>
  <arg name="costmap_cost_scaling_factor" default="70.0"/>
  <!-- Preserve the legacy shared knobs for other profiles, while allowing
       Stage 1 to give global route preference and local collision checking
       different inflation bands. -->
  <arg name="global_costmap_inflation_radius"
       default="$(arg costmap_inflation_radius)"/>
  <arg name="local_costmap_inflation_radius"
       default="$(arg costmap_inflation_radius)"/>
  <arg name="global_costmap_cost_scaling_factor"
       default="$(arg costmap_cost_scaling_factor)"/>
  <arg name="local_costmap_cost_scaling_factor"
       default="$(arg costmap_cost_scaling_factor)"/>
  <arg name="costmap_footprint_padding_m" default="0.0"/>
  <!-- Physical discs are 0.05 m radius.  Competition wrappers may enlarge
       only the collision representation to absorb localization error. -->
  <arg name="disc_collision_radius_m" default="0.05"/>
  <arg name="teb_disc_collision_radius_m"
       default="$(arg disc_collision_radius_m)"/>
  <arg name="local_disc_collision_radius_m"
       default="$(arg disc_collision_radius_m)"/>
  <arg name="passage_total_clearance_m" default="0.02"/>
  <arg name="use_stage1_teb_guard_override" default="false"/>
  <arg name="stage1_teb_guard_config"
       default="$(find yellow_track_avoidance)/config/competition_stage1_teb_guard_override.yaml"/>

  <arg name="map"
       default="$(find yellow_track_avoidance)/maps/competition_blank_5x4.yaml"/>
  <arg name="motion_primitives"
       default="$(find yellow_track_avoidance)/config/yta_5mm_metric.mprim"/>
  <arg name="config"
       default="$(find yellow_track_avoidance)/config/current_car_recalibrated_640x480_20260809.yaml"/>
  <arg name="video_device"
       default="/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._Orbbec_DaBai_DCW2_RGB_Camera_CH8Z16501C1-video-index0"/>
  <arg name="start_camera" default="false"/>
  <arg name="camera_photometry_ready_topic"
       default="/yellow_track_avoidance/camera_photometry_ready"/>
  <arg name="camera_photometry_preview_topic"
       default="/yellow_track_avoidance/camera_photometry_preview"/>
  <arg name="auto_tune_camera_exposure" default="true"/>
  <arg name="start_lidar" default="false"/>
  <arg name="start_imu" default="false"/>
  <arg name="start_odometry" default="false"/>
  <arg name="start_chassis" default="false"/>
  <arg name="start_rviz" default="false"/>
  <arg name="enable_mission_perception_latch" default="true"/>
  <arg name="publish_corridor_goal_preview" default="true"/>
  <arg name="require_lidar_corridor_heading" default="false"/>
  <arg name="lidar_corridor_heading_topic"
       default="/yellow_track_avoidance/stage1_lidar_heading"/>
  <arg name="imu_config"
       default="$(find yellow_track_avoidance)/config/competition_yesense_imu.yaml"/>
  <arg name="ekf_imu_config"
       default="$(find yellow_track_avoidance)/config/competition_robot_localization_wheel_xy_imu_yaw.yaml"/>
  <arg name="imu_topic" default="/imu0"/>
  <arg name="imu_timeout" default="0.2"/>

  <arg name="map_frame" default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="base_footprint_frame" default="base_footprint"/>
  <arg name="vehicle_length_m" default="0.34"/>
  <arg name="vehicle_width_m" default="0.33"/>
  <arg name="vehicle_half_length_m" default="0.17"/>
  <arg name="vehicle_half_width_m" default="0.165"/>
  <!-- Field measurements are inner-edge clear widths.  The corridor node
       consumes yellow centreline separation, so add one complete tape width. -->
  <arg name="yellow_inner_clear_width_m" default="0.91"/>
  <arg name="yellow_line_width_m" default="0.03"/>
  <!-- 2026-08-13 two-point field check: physical front-edge clearances
       0.580/1.210 m versus 0.361/0.989 m in base_link showed a common
       +0.220 m longitudinal-origin correction while preserving scale. -->
  <arg name="local_forward_origin_offset_m" default="0.7663"/>
  <arg name="linear_scale_x" default="1.071"/>
  <arg name="linear_scale_y" default="1.0"/>
  <arg name="angular_scale" default="2.22"/>

  <param name="use_sim_time" value="false"/>
  <param name="yellow_track_competition_planner_profile"
         value="$(arg profile_name)"/>

  <include file="$(find yellow_track_avoidance)/launch/current_car_camera.launch">
    <arg name="start_camera" value="$(arg start_camera)"/>
    <arg name="video_device" value="$(arg video_device)"/>
    <arg name="photometry_ready_topic"
         value="$(arg camera_photometry_ready_topic)"/>
    <arg name="photometry_preview_topic"
         value="$(arg camera_photometry_preview_topic)"/>
    <arg name="auto_tune_exposure"
         value="$(arg auto_tune_camera_exposure)"/>
  </include>

  <node pkg="map_server" type="map_server"
        name="yellow_track_competition_map_server" output="screen"
        args="$(arg map)"/>

  <include file="$(find mowen)/launch/display.launch"/>

  <include if="$(arg start_lidar)"
           file="$(find lslidar_driver)/launch/lslidar_serial.launch"/>

  <!-- Local copy of the previously commissioned bit_ws Yesense parameters.
       Do not include or modify the historical navigation launch. -->
  <node if="$(arg start_imu)" pkg="yesense_imu" type="yesense_imu_node"
        name="yesense_imu_node" output="screen" required="true">
    <rosparam command="load" file="$(arg imu_config)"/>
  </node>

  <group if="$(arg start_odometry)">
    <node pkg="car_bringup" type="pubv.py" name="vel_raw_pub"
          output="screen"/>
    <node pkg="car_bringup" type="base_node" name="odometry_publisher"
          output="screen">
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="base_footprint_frame" value="$(arg base_footprint_frame)"/>
      <param name="linear_scale_x" value="$(arg linear_scale_x)"/>
      <param name="linear_scale_y" value="$(arg linear_scale_y)"/>
      <param name="angular_scale" value="$(arg angular_scale)"/>
      <!-- Keep /odom_raw wheel-only.  The formal IMU profile fuses Yesense
           exactly once, directly in robot_localization below. -->
      <param name="use_imu_yaw" value="false"/>
      <param name="imu_topic" value="$(arg imu_topic)"/>
      <param name="imu_timeout" value="$(arg imu_timeout)"/>
      <remap from="/sub_vel" to="/vel_raw"/>
      <remap from="/pub_odom" to="/odom_raw"/>
      <remap from="/tf"
             to="/yellow_track_avoidance/odom_raw_tf_unused"/>
    </node>
    <!-- Formal competition localization: wheel vx/vy plus direct IMU yaw/wz. -->
    <node if="$(arg start_imu)"
          pkg="robot_localization" type="ekf_localization_node"
          name="ekf_localization" output="screen">
      <remap from="odometry/filtered" to="/odom"/>
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="world_frame" value="$(arg odom_frame)"/>
      <param name="base_link_frame" value="$(arg base_footprint_frame)"/>
      <rosparam command="load"
                file="$(arg ekf_imu_config)"/>
      <param name="odom0" value="/odom_raw"/>
      <param name="imu0" value="$(arg imu_topic)"/>
    </node>
    <!-- Diagnostic wheel-only A/B remains available with start_imu:=false.
         It preserves the historical wheel vx/vy/wz EKF behavior. -->
    <node unless="$(arg start_imu)"
          pkg="robot_localization" type="ekf_localization_node"
          name="ekf_localization" output="screen">
      <remap from="odometry/filtered" to="/odom"/>
      <remap from="/odom0" to="/odom_raw"/>
      <remap from="/imu0" to="/wit/imu"/>
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="world_frame" value="$(arg odom_frame)"/>
      <param name="base_link_frame" value="$(arg base_footprint_frame)"/>
      <rosparam command="load"
                file="$(find car_bringup)/param/robot_localization.yaml"/>
    </node>
  </group>

  <!-- The serial /cmd_vel consumer is the explicit physical-motion switch. -->
  <node if="$(arg start_chassis)" pkg="car_bringup" type="newt.py"
        name="cmd_vel_listener" output="screen" required="true"/>

  <node pkg="tf2_ros" type="static_transform_publisher"
        name="yellow_track_map_to_odom"
        args="0 0 0 0 0 0 $(arg map_frame) $(arg odom_frame)"/>

  <node pkg="yellow_track_avoidance" type="yellow_track_avoidance_node.py"
        name="yellow_track_avoidance" output="screen" required="true">
    <param name="config_file" value="$(arg config)"/>
    <param name="image_topic" value="/usb_cam/image_raw"/>
    <param name="camera_info_topic" value="/usb_cam/camera_info"/>
    <param name="output_cmd_topic"
           value="/yellow_track_avoidance/perception_cmd_vel"/>
    <param name="enable_planning" value="false"/>
    <param name="enable_motion" value="false"/>
    <param name="robot_length_m" value="$(arg vehicle_length_m)"/>
    <param name="robot_width_m" value="$(arg vehicle_width_m)"/>
    <param name="local_forward_origin_offset_m"
           value="$(arg local_forward_origin_offset_m)"/>
    <param name="enable_mission_perception_latch"
           value="$(arg enable_mission_perception_latch)"/>
    <param name="competition_corridor_status_topic"
           value="/yellow_track_competition_corridor_map/status"/>
    <param name="disc_bridge_status_topic"
           value="/yellow_track_disc_costmap_bridge/status"/>
    <param name="scene_reset_topic"
           value="/yellow_track_avoidance/reset_scene"/>
    <!-- Once two reliable discs exist, keep collecting newly confirmed discs
         for three seconds before freezing the complete mission set. -->
    <param name="expected_frozen_disc_count" value="2"/>
    <param name="perception_lock_stable_sec" value="3.0"/>
    <param name="locked_status_period_sec" value="1.0"/>
    <!-- Do not lock the corridor or disc tracks while cold-start AWB is
         still changing the colour and apparent yellow-line direction. -->
    <param name="require_photometry_ready" value="$(arg start_camera)"/>
    <param name="photometry_ready_topic"
           value="$(arg camera_photometry_ready_topic)"/>
    <param name="photometry_preview_topic"
           value="$(arg camera_photometry_preview_topic)"/>
  </node>

  <node pkg="yellow_track_avoidance" type="disc_laserscan_bridge.py"
        name="yellow_track_disc_costmap_bridge" output="screen" required="true">
    <param name="frame_id" value="$(arg base_frame)"/>
    <param name="fixed_frame" value="$(arg odom_frame)"/>
    <param name="planning_frame" value="$(arg map_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="local_forward_origin_offset_m"
           value="$(arg local_forward_origin_offset_m)"/>
    <param name="disk_radius_m" value="0.05"/>
    <param name="costmap_disk_radius_m"
           value="$(arg disc_collision_radius_m)"/>
    <param name="enable_costmap_writes" value="true"/>
    <param name="competition_two_disc_mode" value="false"/>
    <param name="lock_confirmed_discs_for_mission" value="true"/>
    <param name="publish_rate_hz" value="10.0"/>
    <param name="angle_min_rad" value="-3.141592653589793"/>
    <param name="angle_max_rad" value="3.141592653589793"/>
    <param name="input_timeout_sec" value="0.8"/>
    <param name="confirmed_memory_timeout_sec" value="30.0"/>
    <param name="unconfirmed_memory_timeout_sec" value="0.8"/>
    <param name="memory_merge_distance_m" value="0.12"/>
    <param name="memory_smoothing_alpha" value="0.25"/>
    <param name="marker_persistence_sec" value="0.3"/>
    <param name="global_path_topic" value="$(arg global_plan_topic)"/>
    <param name="move_base_status_topic" value="/move_base/status"/>
    <param name="navigation_gate_status_topic"
           value="/yellow_track_navigation_gate/status"/>
    <param name="scene_reset_topic"
           value="/yellow_track_avoidance/reset_scene"/>
    <param name="require_navigation_gate_for_scene_reset" value="false"/>
    <param name="output_command_topic" value="/cmd_vel"/>
    <param name="odom_topic" value="/odom"/>
    <param name="global_path_timeout_sec" value="5.0"/>
    <param name="vehicle_half_length_m"
           value="$(arg vehicle_half_length_m)"/>
    <param name="vehicle_half_width_m"
           value="$(arg vehicle_half_width_m)"/>
    <param name="require_localization_ready" value="false"/>
  </node>

  <node pkg="yellow_track_avoidance" type="competition_corridor_map.py"
        name="yellow_track_competition_corridor_map" output="screen"
        required="true">
    <param name="boundary_topic"
           value="/yellow_track_avoidance/debug/boundaries"/>
    <param name="fixed_frame" value="$(arg odom_frame)"/>
    <param name="cloud_topic"
           value="/yellow_track_avoidance/corridor_cloud"/>
    <param name="marker_topic"
           value="/yellow_track_avoidance/corridor_markers"/>
    <param name="centerline_topic"
           value="/yellow_track_avoidance/corridor_centerline"/>
    <param name="locked_boundary_topic"
           value="/yellow_track_avoidance/corridor_boundaries"/>
    <param name="scene_reset_topic"
           value="/yellow_track_avoidance/reset_scene"/>
    <param name="minimum_quality" value="0.40"/>
    <param name="center_separation_m"
           value="$(eval float(arg('yellow_inner_clear_width_m')) + float(arg('yellow_line_width_m')))"/>
    <param name="yellow_line_width_m" value="$(arg yellow_line_width_m)"/>
    <param name="vehicle_front_offset_m"
           value="$(arg vehicle_half_length_m)"/>
    <!-- Vehicle front starts level with the near yellow-line endpoint:
         start overshoot is 0.00 m, so use the full 1.85 m line length. -->
    <param name="corridor_length_m" value="1.85"/>
    <param name="publish_goal_on_lock" value="false"/>
    <param name="goal_topic" value="/move_base_simple/goal"/>
    <param name="goal_pose_topic"
           value="/yellow_track_avoidance/corridor_goal"/>
    <param name="goal_left_from_right_endpoint_m" value="0.24"/>
    <param name="goal_forward_from_right_endpoint_m" value="0.57"/>
    <param name="vehicle_width_m" value="$(arg vehicle_width_m)"/>
    <param name="preview_plan_topic"
           value="/yellow_track_avoidance/corridor_goal_plan"/>
    <param name="publish_goal_preview"
           value="$(arg publish_corridor_goal_preview)"/>
    <param name="make_plan_service" value="/move_base/make_plan"/>
    <param name="preview_plan_tolerance_m" value="0.08"/>
    <param name="preview_plan_retry_sec" value="1.0"/>
    <param name="sample_resolution_m" value="0.01"/>
    <param name="required_frames" value="5"/>
    <param name="maximum_yaw_spread_deg" value="2.0"/>
    <param name="maximum_lateral_spread_m" value="0.025"/>
    <param name="require_lidar_heading_reference"
           value="$(arg require_lidar_corridor_heading)"/>
    <param name="lidar_heading_topic"
           value="$(arg lidar_corridor_heading_topic)"/>
    <param name="lidar_heading_reference_weight" value="0.65"/>
    <param name="maximum_lidar_heading_disagreement_deg" value="3.0"/>
    <param name="maximum_lidar_heading_correction_deg" value="1.0"/>
  </node>

  <!--
    Optional A/B-only semantic obstacle input.  GlobalPlanner and both
    costmaps retain the complete lethal-cell world; only TEB's optimization
    container receives the two inner boundary lines and every frozen circle.
  -->
  <node if="$(arg use_compact_teb_obstacles)"
        pkg="yellow_track_avoidance" type="teb_compact_obstacles.py"
        name="yellow_track_teb_compact_obstacles" output="screen"
        required="true">
    <param name="boundary_topic"
           value="/yellow_track_avoidance/corridor_boundaries"/>
    <param name="disc_status_topic"
           value="/yellow_track_disc_costmap_bridge/status"/>
    <param name="output_topic"
           value="/move_base/TebLocalPlannerROS/obstacles"/>
    <param name="disc_radius_m" value="0.05"/>
    <param name="disc_collision_radius_m"
           value="$(arg disc_collision_radius_m)"/>
    <param name="teb_disc_collision_radius_m"
           value="$(arg teb_disc_collision_radius_m)"/>
    <param name="local_disc_collision_radius_m"
           value="$(arg local_disc_collision_radius_m)"/>
    <param name="yellow_line_width_m" value="$(arg yellow_line_width_m)"/>
    <param name="enable_passage_closures"
           value="$(arg enable_stage1_passage_closures)"/>
    <param name="include_passage_closures_in_teb"
           value="$(arg include_passage_closures_in_teb)"/>
    <param name="publish_full_disc_cloud"
           value="$(arg publish_sbpl_full_disc_cloud)"/>
    <param name="full_disc_cloud_topic"
           value="/yellow_track_avoidance/sbpl_disc_cloud"/>
    <param name="local_full_disc_cloud_topic"
           value="/yellow_track_avoidance/local_disc_cloud"/>
    <param name="full_disc_sample_resolution_m" value="0.005"/>
    <param name="vehicle_width_m" value="$(arg vehicle_width_m)"/>
    <param name="passage_total_clearance_m"
           value="$(arg passage_total_clearance_m)"/>
    <param name="side_tie_tolerance_m" value="0.01"/>
    <param name="closure_sample_resolution_m" value="0.005"/>
    <param name="closure_cloud_topic"
           value="/yellow_track_avoidance/passage_closure_cloud"/>
    <param name="closure_marker_topic"
           value="/yellow_track_avoidance/passage_closure_markers"/>
    <param name="publish_rate_hz" value="5.0"/>
    <param name="minimum_disc_count" value="2"/>
  </node>

  <node pkg="move_base" type="move_base" name="move_base"
        output="screen" clear_params="true">
    <env name="LD_LIBRARY_PATH"
         value="$(find yellow_track_avoidance)/vendor/sbpl_signed_char/lib:$(optenv LD_LIBRARY_PATH)"/>
    <rosparam command="load"
              file="$(arg costmap_common_config)"
              ns="global_costmap"/>
    <rosparam command="load"
              file="$(arg costmap_common_config)"
              ns="local_costmap"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_global_costmap.yaml"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_local_costmap.yaml"/>
    <!-- A wrapper may give the global and local layers different semantic
         inputs.  In Stage 1, the global layer alone receives virtual passage
         closures; the local layer contains only physical boundaries/discs. -->
    <param name="global_costmap/observation_sources"
           value="$(arg global_costmap_observation_sources)"/>
    <param name="local_costmap/observation_sources"
           value="$(arg local_costmap_observation_sources)"/>
    <!-- Profile-specific override. Keep the legacy/default profiles at
         0.24 m while allowing Stage 1 to use a tighter traversable band. -->
    <param name="global_costmap/inflation_radius"
           value="$(arg global_costmap_inflation_radius)"/>
    <param name="local_costmap/inflation_radius"
           value="$(arg local_costmap_inflation_radius)"/>
    <param name="global_costmap/inflation_layer/inflation_radius"
           value="$(arg global_costmap_inflation_radius)"/>
    <param name="local_costmap/inflation_layer/inflation_radius"
           value="$(arg local_costmap_inflation_radius)"/>
    <param name="global_costmap/cost_scaling_factor"
           value="$(arg global_costmap_cost_scaling_factor)"/>
    <param name="local_costmap/cost_scaling_factor"
           value="$(arg local_costmap_cost_scaling_factor)"/>
    <param name="global_costmap/inflation_layer/cost_scaling_factor"
           value="$(arg global_costmap_cost_scaling_factor)"/>
    <param name="local_costmap/inflation_layer/cost_scaling_factor"
           value="$(arg local_costmap_cost_scaling_factor)"/>
    <param name="global_costmap/footprint_padding"
           value="$(arg costmap_footprint_padding_m)"/>
    <param name="local_costmap/footprint_padding"
           value="$(arg costmap_footprint_padding_m)"/>
    <rosparam command="load" file="$(arg move_base_config)"/>
    <rosparam command="load" file="$(arg global_planner_config)"/>
    <rosparam command="load" file="$(arg local_planner_config)"/>
    <!-- The compact profile changes this one TEB parameter only. -->
    <rosparam if="$(arg use_compact_teb_obstacles)"
              command="load"
              file="$(find yellow_track_avoidance)/config/competition_teb_compact_obstacles_override.yaml"/>
    <rosparam if="$(arg use_stage1_teb_guard_override)"
              command="load"
              file="$(arg stage1_teb_guard_config)"/>
    <param name="base_global_planner" value="$(arg global_planner_plugin)"/>
    <param name="base_local_planner" value="$(arg local_planner_plugin)"/>
    <param if="$(arg use_sbpl)"
           name="SBPLLatticePlanner/primitive_filename"
           value="$(arg motion_primitives)"/>
    <rosparam param="global_costmap/footprint" subst_value="true">
      [[-$(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)],
       [-$(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)]]
    </rosparam>
    <rosparam param="local_costmap/footprint" subst_value="true">
      [[-$(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)],
       [-$(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)]]
    </rosparam>
    <rosparam if="$(arg use_teb)"
              param="TebLocalPlannerROS/footprint_model/vertices"
              subst_value="true">
      [[-$(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)],
       [-$(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)]]
    </rosparam>
  </node>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="rviz"
        output="screen"
        args="-d $(find yellow_track_avoidance)/config/navigation.rviz"/>
</launch>
