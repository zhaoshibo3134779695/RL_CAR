<launch>
  <!--
    Full RViz click-to-navigate entrypoint for the current robot.
    move_base is remapped through navigation_safety_gate; only the gate owns
    /cmd_vel. Motion remains service-disabled until explicitly enabled.
  -->
  <arg name="map" default="$(find yellow_track_avoidance)/maps/track_7_15_5x4.yaml"/>
  <arg name="config"
       default="$(find yellow_track_avoidance)/config/calibrated_1920x1080_checkerboard.yaml"/>
  <arg name="motion_primitives"
       default="$(find yellow_track_avoidance)/config/yta_1cm.mprim"/>
  <arg name="rviz_config"
       default="$(find yellow_track_avoidance)/config/navigation.rviz"/>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>
  <!-- Keep the proven SBPL + TEB stack as the default, while allowing the
       straight competition segment to select the lighter GlobalPlanner + DWA
       pair at launch time without changing package configuration files. -->
  <arg name="global_planner_plugin" default="SBPLLatticePlanner"/>
  <arg name="local_planner_plugin"
       default="teb_local_planner/TebLocalPlannerROS"/>
  <arg name="global_plan_topic"
       default="/move_base/SBPLLatticePlanner/plan"/>

  <arg name="start_camera" default="true"/>
  <arg name="start_lidar" default="true"/>
  <arg name="start_chassis" default="true"/>
  <arg name="start_odometry" default="$(arg start_chassis)"/>
  <arg name="start_imu" default="false"/>
  <arg name="start_rviz" default="true"/>
  <arg name="start_perception_views" default="true"/>
  <arg name="apply_camera_photometry" default="true"/>
  <arg name="color_width" default="1920"/>
  <arg name="color_height" default="1080"/>
  <arg name="color_fps" default="30"/>
  <arg name="auto_field_localization" default="true"/>
  <arg name="use_amcl" default="true"/>
  <arg name="start_competition_corridor_map" default="false"/>
  <arg name="competition_corridor_length_m" default="1.85"/>
  <arg name="publish_corridor_goal_on_lock" default="false"/>
  <arg name="corridor_goal_left_offset_m" default="0.24"/>
  <arg name="corridor_goal_forward_offset_m" default="0.54"/>
  <arg name="navigation_boundary_topic"
       default="/yellow_track_avoidance/debug/boundaries"/>
  <arg name="terminal_boundary_topic"
       default="/yellow_track_avoidance/debug/boundaries"/>
  <arg name="enable_motion" default="false"/>
  <arg name="start_enabled" default="false"/>

  <arg name="map_frame" default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="base_footprint_frame" default="base_footprint"/>
  <arg name="enable_passage_supervisor" default="true"/>
  <arg name="finish_recovery_enabled" default="true"/>
  <arg name="passage_minimum_predicted_gate_clearance_m" default="0.020"/>
  <arg name="competition_two_disc_mode" default="false"/>
  <arg name="enable_gate_special_mode" default="false"/>
  <arg name="claim_all_road_discs" default="true"/>
  <arg name="force_between_disc_pair" default="false"/>
  <arg name="competition_finish_priority" default="false"/>
  <arg name="disc_confirmed_memory_timeout_sec" default="30.0"/>
  <arg name="disc_mission_lock_enabled" default="false"/>
  <arg name="passage_track_fresh_sec" default="2.0"/>
  <arg name="passage_activation_zone_enabled" default="false"/>
  <arg name="disc_costmap_writes_enabled" default="true"/>
  <arg name="enforce_boundary_in_activation_zone" default="false"/>
  <arg name="enforce_disc_emergency_clearance" default="true"/>
  <arg name="disc_emergency_clearance_m" default="0.005"/>
  <arg name="initial_x" default="4.15"/>
  <arg name="initial_y" default="3.49"/>
  <arg name="initial_yaw" default="3.141592653589793"/>
  <!-- One source of truth for physical vehicle geometry. The half dimensions
       are derived for footprint-based nodes and can still be overridden for
       unusual asymmetric platforms. -->
  <arg name="vehicle_length_m" default="0.33"/>
  <arg name="vehicle_width_m" default="0.30"/>
  <arg name="vehicle_half_length_m"
       default="$(eval 0.5 * float(arg('vehicle_length_m')))"/>
  <arg name="vehicle_half_width_m"
       default="$(eval 0.5 * float(arg('vehicle_width_m')))"/>
  <arg name="local_forward_origin_offset_m" default="0.39"/>
  <arg name="linear_scale_x" default="1.0"/>
  <arg name="linear_scale_y" default="1.0"/>
  <arg name="angular_scale" default="1.0"/>

  <param name="use_sim_time" value="false"/>

  <node pkg="map_server" type="map_server" name="yellow_track_map_server"
        output="screen" args="$(arg map)"/>

  <include if="$(arg start_camera)"
           file="$(find orbbec_camera)/launch/dabai_dcw2.launch">
    <arg name="camera_name" value="camera"/>
    <arg name="color_width" value="$(arg color_width)"/>
    <arg name="color_height" value="$(arg color_height)"/>
    <arg name="color_fps" value="$(arg color_fps)"/>
    <arg name="enable_color" value="true"/>
    <arg name="enable_color_auto_exposure" value="false"/>
    <arg name="enable_depth" value="false"/>
    <arg name="enable_ir" value="false"/>
    <arg name="enable_point_cloud" value="false"/>
    <arg name="publish_tf" value="true"/>
  </include>

  <node if="$(arg apply_camera_photometry)"
        pkg="yellow_track_avoidance" type="orbbec_photometry.py"
        name="yellow_track_orbbec_photometry" output="screen"
        args="--config $(arg config)"/>

  <include if="$(arg start_lidar)"
           file="$(find lslidar_driver)/launch/lslidar_serial.launch"/>

  <include file="$(find mowen)/launch/display.launch"/>

  <!-- The current /dev/ttyUSB0 is the chassis adapter. start_imu defaults to
       false because the legacy IMU launch also points at /dev/ttyUSB0. -->
  <include if="$(arg start_imu)" file="$(find wit_ros_imu)/launch/wit_imu.launch"/>

  <group if="$(arg start_odometry)">
    <node pkg="car_bringup" type="pubv.py" name="vel_raw_pub"
          output="screen"/>
    <node pkg="car_bringup" type="base_node" name="odometry_publisher"
          output="screen">
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="base_footprint_frame" value="$(arg base_footprint_frame)"/>
      <param name="linear_scale_x" value="$(arg linear_scale_x)"/>
      <param name="linear_scale_y" value="$(arg linear_scale_y)"/>
      <param name="angular_scale" value="$(arg angular_scale)"/>
      <remap from="/sub_vel" to="/vel_raw"/>
      <remap from="/pub_odom" to="/odom_raw"/>
      <!-- base_node always broadcasts raw odom -> base_footprint. Keep that
           transform off /tf so the filtered EKF output is the sole owner. -->
      <remap from="/tf"
             to="/yellow_track_avoidance/odom_raw_tf_unused"/>
    </node>
    <node pkg="robot_localization" type="ekf_localization_node"
          name="ekf_localization" output="screen">
      <remap from="odometry/filtered" to="/odom"/>
      <remap from="/odom0" to="/odom_raw"/>
      <remap from="/imu0" to="/wit/imu"/>
      <param name="odom_frame" value="$(arg odom_frame)"/>
      <param name="world_frame" value="$(arg odom_frame)"/>
      <param name="base_link_frame" value="$(arg base_footprint_frame)"/>
      <rosparam command="load"
                file="$(find car_bringup)/param/robot_localization.yaml"/>
    </node>
  </group>

  <!-- Keep serial feedback/odometry usable during zero-motion commissioning
       without starting the /cmd_vel-to-serial command bridge. -->
  <node if="$(arg start_chassis)"
        pkg="car_bringup" type="newt.py" name="cmd_vel_listener"
        output="screen" required="true"/>

  <node if="$(arg use_amcl)" pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="/scan"/>
    <param name="global_frame_id" value="$(arg map_frame)"/>
    <param name="odom_frame_id" value="$(arg odom_frame)"/>
    <param name="base_frame_id" value="$(arg base_frame)"/>
    <param name="odom_model_type" value="omni"/>
    <param name="gui_publish_rate" value="20.0"/>
    <param name="laser_max_range" value="6.0"/>
    <param name="laser_max_beams" value="360"/>
    <param name="min_particles" value="1000"/>
    <param name="max_particles" value="3000"/>
    <param name="kld_err" value="0.05"/>
    <param name="kld_z" value="0.99"/>
    <param name="odom_alpha1" value="0.2"/>
    <param name="odom_alpha2" value="0.2"/>
    <param name="odom_alpha3" value="0.2"/>
    <param name="odom_alpha4" value="0.2"/>
    <param name="odom_alpha5" value="0.2"/>
    <param name="laser_model_type" value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="1.0"/>
    <param name="update_min_d" value="0.01"/>
    <param name="update_min_a" value="0.02"/>
    <param name="transform_tolerance" value="0.35"/>
    <param name="initial_pose_x" value="$(arg initial_x)"/>
    <param name="initial_pose_y" value="$(arg initial_y)"/>
    <param name="initial_pose_a" value="$(arg initial_yaw)"/>
  </node>

  <!-- Corridor-only competition mode uses startup odometry as its local map
       origin. The blank map is only an SBPL canvas; no AMCL correction can
       drag camera geometry toward unrelated wall pixels. -->
  <node unless="$(arg use_amcl)" pkg="tf2_ros"
        type="static_transform_publisher" name="yellow_track_map_to_odom"
        args="0 0 0 0 0 0 $(arg map_frame) $(arg odom_frame)"/>

  <node pkg="yellow_track_avoidance" type="yellow_track_avoidance_node.py"
        name="yellow_track_avoidance" output="screen" required="true">
    <param name="config_file" value="$(arg config)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="output_cmd_topic"
           value="/yellow_track_avoidance/perception_cmd_vel"/>
    <!-- Detection only: SBPL+TEB and the passage supervisor are the only
         active planners/controllers in competition mode. -->
    <param name="enable_planning" value="false"/>
    <param name="enable_motion" value="false"/>
    <param name="robot_length_m" value="$(arg vehicle_length_m)"/>
    <param name="robot_width_m" value="$(arg vehicle_width_m)"/>
    <param name="local_forward_origin_offset_m"
           value="$(arg local_forward_origin_offset_m)"/>
  </node>

  <node pkg="yellow_track_avoidance" type="disc_laserscan_bridge.py"
        name="yellow_track_disc_costmap_bridge" output="screen" required="true">
    <param name="frame_id" value="$(arg base_frame)"/>
    <param name="fixed_frame" value="$(arg odom_frame)"/>
    <param name="planning_frame" value="$(arg map_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="local_forward_origin_offset_m"
           value="$(arg local_forward_origin_offset_m)"/>
    <param name="disk_radius_m" value="0.05"/>
    <param name="enable_costmap_writes"
           value="$(arg disc_costmap_writes_enabled)"/>
    <param name="competition_two_disc_mode"
           value="$(arg competition_two_disc_mode)"/>
    <param name="lock_confirmed_discs_for_mission"
           value="$(arg disc_mission_lock_enabled)"/>
    <!-- The camera produces about 7.8 new detections/s. A 10 Hz, 360-degree
         virtual scan keeps every fixed active obstacle marked as it moves to
         the side/rear. It is suppressed only after route progress, complete
         footprint clearance, and a sustained confirmation all agree. -->
    <param name="publish_rate_hz" value="10.0"/>
    <param name="angle_min_rad" value="-3.141592653589793"/>
    <param name="angle_max_rad" value="3.141592653589793"/>
    <param name="input_timeout_sec" value="0.8"/>
    <param name="confirmed_memory_timeout_sec"
           value="$(arg disc_confirmed_memory_timeout_sec)"/>
    <param name="unconfirmed_memory_timeout_sec" value="0.8"/>
    <param name="memory_merge_distance_m" value="0.12"/>
    <param name="memory_smoothing_alpha" value="0.25"/>
    <param name="marker_persistence_sec" value="0.3"/>
    <param name="global_path_topic"
           value="$(arg global_plan_topic)"/>
    <param name="move_base_status_topic" value="/move_base/status"/>
    <param name="navigation_gate_status_topic"
           value="/yellow_track_navigation_gate/status"/>
    <param name="output_command_topic" value="/cmd_vel"/>
    <param name="odom_topic" value="/odom"/>
    <param name="global_path_timeout_sec" value="5.0"/>
    <param name="vehicle_half_length_m"
           value="$(arg vehicle_half_length_m)"/>
    <param name="vehicle_half_width_m"
           value="$(arg vehicle_half_width_m)"/>
    <param name="pass_progress_margin_m" value="0.05"/>
    <param name="pass_clearance_m" value="0.03"/>
    <param name="pass_confirm_duration_sec" value="1.0"/>
    <param name="pass_confirm_frames" value="8"/>
    <param name="pass_min_advance_m" value="0.10"/>
    <param name="pass_projection_max_distance_m" value="0.35"/>
    <param name="pass_projection_back_segments" value="5"/>
    <param name="pass_projection_forward_segments" value="20"/>
    <param name="pass_max_progress_jump_m" value="0.10"/>
    <param name="pass_path_back_length_m" value="0.60"/>
    <param name="pass_path_forward_length_m" value="1.20"/>
    <param name="pass_path_resample_m" value="0.03"/>
    <param name="pass_candidate_backtrack_reset_m" value="0.03"/>
    <param name="passed_tombstone_sec" value="20.0"/>
    <param name="passed_reacquire_suppression_m" value="0.15"/>
    <param name="tombstone_reactivate_backtrack_m" value="0.20"/>
    <!-- During automatic startup localization, detections remain visible but
         cannot enter costmap_2d under AMCL's provisional initial transform.
         The latched "localized" status opens marking only after /initialpose
         has settled and the one-shot costmap clear has completed. -->
    <param name="require_localization_ready"
           value="$(arg auto_field_localization)"/>
    <param name="localization_status_topic"
           value="/yellow_track_field_localization/status"/>
  </node>

  <node if="$(arg start_competition_corridor_map)"
        pkg="yellow_track_avoidance" type="competition_corridor_map.py"
        name="yellow_track_competition_corridor_map" output="screen"
        required="true">
    <param name="boundary_topic"
           value="/yellow_track_avoidance/debug/boundaries"/>
    <param name="fixed_frame" value="$(arg odom_frame)"/>
    <param name="cloud_topic"
           value="/yellow_track_avoidance/corridor_cloud"/>
    <param name="marker_topic"
           value="/yellow_track_avoidance/corridor_markers"/>
    <param name="centerline_topic"
           value="/yellow_track_avoidance/corridor_centerline"/>
    <param name="locked_boundary_topic"
           value="/yellow_track_avoidance/corridor_boundaries"/>
    <param name="minimum_quality" value="0.40"/>
    <param name="center_separation_m" value="0.91"/>
    <param name="yellow_line_width_m" value="0.03"/>
    <param name="vehicle_front_offset_m"
           value="$(arg vehicle_half_length_m)"/>
    <param name="corridor_length_m"
           value="$(arg competition_corridor_length_m)"/>
    <param name="publish_goal_on_lock"
           value="$(arg publish_corridor_goal_on_lock)"/>
    <param name="goal_topic" value="/move_base_simple/goal"/>
    <param name="goal_pose_topic"
           value="/yellow_track_avoidance/corridor_goal"/>
    <param name="goal_left_from_right_endpoint_m"
           value="$(arg corridor_goal_left_offset_m)"/>
    <param name="goal_forward_from_right_endpoint_m"
           value="$(arg corridor_goal_forward_offset_m)"/>
    <param name="vehicle_width_m" value="$(arg vehicle_width_m)"/>
    <param name="preview_plan_topic"
           value="/yellow_track_avoidance/corridor_goal_plan"/>
    <param name="make_plan_service" value="/move_base/make_plan"/>
    <param name="preview_plan_tolerance_m" value="0.08"/>
    <param name="preview_plan_retry_sec" value="1.0"/>
    <param name="sample_resolution_m" value="0.01"/>
    <param name="required_frames" value="5"/>
    <param name="maximum_yaw_spread_deg" value="2.0"/>
    <param name="maximum_lateral_spread_m" value="0.025"/>
  </node>

  <node if="$(arg use_amcl)"
        pkg="yellow_track_avoidance" type="field_pose_localizer.py"
        name="yellow_track_field_localization" output="screen" required="true">
    <param name="map_yaml" value="$(arg map)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="scan_topic" value="/scan"/>
    <param name="boundary_topic"
           value="/yellow_track_avoidance/debug/boundaries"/>
    <!-- Stationary fusion is intentionally restricted to the known far
         upper-right competition segment. Only the left yellow edge is
         observed; the right wall is reconstructed from the calibrated lane
         width. Lidar endpoints then correct that geometry against the map. -->
    <param name="minimum_boundary_quality" value="0.40"/>
    <rosparam param="search_bounds_m">[1.55, 1.20, 2.35, 1.95]</rosparam>
    <param name="yellow_to_wall_distance_m" value="0.05"/>
    <param name="lidar_weight" value="0.20"/>
    <param name="yellow_weight" value="4.0"/>
    <param name="maximum_match_score" value="0.08"/>
    <param name="maximum_wall_score" value="0.02"/>
    <!-- The field's long straight wall can produce a close translation-only
         runner-up even when the wall and lidar fit are both strong. -->
    <param name="minimum_score_margin" value="0.003"/>
    <!-- On every live launch, wait for current lidar/yellow-wall data and
         correct AMCL through /initialpose. Failure leaves the gate locked. -->
    <param name="auto_localize_on_start"
           value="$(arg auto_field_localization)"/>
    <param name="startup_delay_sec" value="2.0"/>
    <param name="startup_timeout_sec" value="90.0"/>
    <param name="startup_retry_interval_sec" value="1.0"/>
    <param name="gate_service"
           value="/yellow_track_navigation_gate/set_enabled"/>
    <param name="clear_costmaps_service"
           value="/move_base/clear_costmaps"/>
  </node>

  <node pkg="move_base" type="move_base" name="move_base"
        output="screen" clear_params="true">
    <!-- Keep the package-local, host-architecture SBPL runtime scoped to
         move_base so the original lattice planner keeps signed-char motion
         primitive semantics without replacing system libraries. -->
    <env name="LD_LIBRARY_PATH"
         value="$(find yellow_track_avoidance)/vendor/sbpl_signed_char/lib:$(optenv LD_LIBRARY_PATH)"/>
    <remap from="cmd_vel"
           to="/yellow_track_avoidance/move_base_cmd_vel"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_costmap_common.yaml"
              ns="global_costmap"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_costmap_common.yaml"
              ns="local_costmap"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_global_costmap.yaml"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_local_costmap.yaml"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_move_base.yaml"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_global_planner.yaml"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_sbpl.yaml"/>
    <param name="SBPLLatticePlanner/primitive_filename"
           value="$(arg motion_primitives)"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_teb.yaml"/>
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/click_nav_dwa.yaml"/>
    <!-- These overrides intentionally follow click_nav_move_base.yaml. The
         YAML remains the stable SBPL + TEB default; launch arguments select a
         reversible test profile. -->
    <param name="base_global_planner" value="$(arg global_planner_plugin)"/>
    <param name="base_local_planner" value="$(arg local_planner_plugin)"/>
    <!-- Override every footprint loaded from the legacy YAML files with the
         dimensions selected at this launch boundary. -->
    <rosparam param="global_costmap/footprint" subst_value="true">
      [[-$(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)],
       [-$(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)]]
    </rosparam>
    <rosparam param="local_costmap/footprint" subst_value="true">
      [[-$(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)],
       [-$(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)]]
    </rosparam>
    <rosparam param="TebLocalPlannerROS/footprint_model/vertices"
              subst_value="true">
      [[-$(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)],
       [-$(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m),  $(arg vehicle_half_width_m)],
       [ $(arg vehicle_half_length_m), -$(arg vehicle_half_width_m)]]
    </rosparam>
  </node>

  <node pkg="yellow_track_avoidance" type="navigation_safety_gate.py"
        name="yellow_track_navigation_gate" output="screen" required="true">
    <param name="input_cmd_topic"
           value="/yellow_track_avoidance/move_base_cmd_vel"/>
    <param name="special_input_cmd_topic"
           value="/yellow_track_avoidance/passage_cmd_vel"/>
    <param name="special_status_topic"
           value="/yellow_track_avoidance/passage/status"/>
    <param name="special_timeout_sec" value="0.25"/>
    <param name="output_cmd_topic" value="/cmd_vel"/>
    <param name="enable_motion" value="$(arg enable_motion)"/>
    <param name="start_enabled" value="$(arg start_enabled)"/>
    <param name="maximum_linear_speed_mps" value="0.10"/>
    <param name="maximum_angular_speed_radps" value="0.30"/>
    <!-- Compatibility service now performs a zero-motion camera-yellow plus
         lidar-map fusion request. It never enables the gate or commands a
         localization spin. -->
    <param name="field_localization_service"
           value="/yellow_track_field_localization/localize"/>
    <param name="move_base_cancel_topic" value="/move_base/cancel"/>
    <!-- DWA owns the ordinary route. Inside the final 12 cm, live yellow-line
         geometry takes over for parallel alignment and a slow final creep.
         Precision stop and the independent overrun guard both latch below all
         other command sources. -->
    <param name="terminal_goal_stop_enabled"
           value="$(arg start_competition_corridor_map)"/>
    <param name="terminal_goal_topic"
           value="/yellow_track_avoidance/corridor_goal"/>
    <param name="terminal_goal_odom_topic" value="/odom"/>
    <param name="terminal_boundary_topic"
           value="$(arg terminal_boundary_topic)"/>
    <param name="terminal_line_minimum_quality" value="0.50"/>
    <param name="terminal_goal_odom_timeout_sec" value="0.30"/>
    <param name="terminal_takeover_remaining_m" value="0.12"/>
    <param name="terminal_required_line_frames" value="3"/>
    <param name="terminal_line_propagation_sec" value="0.25"/>
    <param name="terminal_line_wait_sec" value="0.80"/>
    <param name="terminal_corridor_width_m" value="0.91"/>
    <param name="terminal_left_line_reference_m"
           value="$(eval 0.91 - float(arg('corridor_goal_left_offset_m')))"/>
    <param name="terminal_boundary_margin_m" value="0.015"/>
    <param name="terminal_minimum_sweep_clearance_m" value="0.020"/>
    <param name="terminal_aligned_stable_sec" value="0.40"/>
    <param name="terminal_stop_min_remaining_m" value="-0.005"/>
    <param name="terminal_stop_max_remaining_m" value="0.015"/>
    <param name="terminal_stop_lateral_m" value="0.008"/>
    <param name="terminal_stop_yaw_rad" value="0.0261799388"/>
    <param name="terminal_stop_linear_speed_mps" value="0.010"/>
    <param name="terminal_stop_angular_speed_radps" value="0.025"/>
    <param name="terminal_stop_stable_sec" value="0.40"/>
    <param name="terminal_overrun_m" value="0.025"/>
    <param name="terminal_dwa_fallback_linear_mps" value="0.03"/>
    <param name="terminal_dwa_fallback_angular_radps" value="0.10"/>
    <!-- The selected move_base local planner owns ordinary trajectory
         selection. The gate still requires live calibrated yellow boundaries
         and enforces physical emergency clearance around every detected disc. -->
    <param name="allow_move_base_when_local_planner_blocked" value="true"/>
    <!-- Camera detections feed visualization and the optional disc costmap;
         the selected local planner still owns ordinary trajectory choice. -->
    <param name="enforce_perception_safety" value="false"/>
    <!-- Inside the configured map polygon, every ordinary planner command must
         pass the supervisor's fresh-boundary swept-footprint check. -->
    <param name="enforce_boundary_in_activation_zone"
           value="$(arg enforce_boundary_in_activation_zone)"/>
    <param name="enforce_disc_emergency_clearance"
           value="$(arg enforce_disc_emergency_clearance)"/>
    <param name="minimum_boundary_quality" value="0.50"/>
    <!-- Competition contact tolerance: physical edge-to-disc gap. -->
    <param name="emergency_clearance_m"
           value="$(arg disc_emergency_clearance_m)"/>
    <param name="vehicle_half_length_m"
           value="$(arg vehicle_half_length_m)"/>
    <param name="vehicle_half_width_m"
           value="$(arg vehicle_half_width_m)"/>
    <param name="disk_radius_m" value="0.05"/>
    <param name="local_forward_origin_offset_m"
           value="$(arg local_forward_origin_offset_m)"/>
  </node>

  <!-- Normal navigation uses the selected move_base planners. The supervisor classifies local
       free-space topology, cancels move_base before deterministic single,
       multi-disc or narrow-gate control, then resumes the saved final goal.
       It never publishes directly to the chassis /cmd_vel. -->
  <node if="$(arg enable_passage_supervisor)"
        pkg="yellow_track_avoidance" type="passage_supervisor.py"
        name="yellow_track_passage_supervisor"
        output="screen" required="true">
    <rosparam command="load"
              file="$(find yellow_track_avoidance)/config/passage_supervisor.yaml"/>
    <param name="competition_two_disc_mode"
           value="$(arg competition_two_disc_mode)"/>
    <param name="enable_gate_special_mode"
           value="$(arg enable_gate_special_mode)"/>
    <param name="claim_all_road_discs"
           value="$(arg claim_all_road_discs)"/>
    <param name="force_between_disc_pair"
           value="$(arg force_between_disc_pair)"/>
    <param name="competition_finish_priority"
           value="$(arg competition_finish_priority)"/>
    <param name="track_fresh_sec"
           value="$(arg passage_track_fresh_sec)"/>
    <param name="vehicle_half_length_m"
           value="$(arg vehicle_half_length_m)"/>
    <param name="vehicle_half_width_m"
           value="$(arg vehicle_half_width_m)"/>
    <param name="enabled" value="$(arg enable_passage_supervisor)"/>
    <param name="finish_recovery_enabled"
           value="$(arg finish_recovery_enabled)"/>
    <param name="minimum_predicted_gate_clearance_m"
           value="$(arg passage_minimum_predicted_gate_clearance_m)"/>
    <param name="activation_zone_enabled"
           value="$(arg passage_activation_zone_enabled)"/>
    <param name="fixed_frame" value="$(arg odom_frame)"/>
    <param name="global_path_topic"
           value="$(arg global_plan_topic)"/>
    <param name="disc_status_topic"
           value="/yellow_track_disc_costmap_bridge/status"/>
    <param name="disc_scene_reset_service"
           value="/yellow_track_disc_costmap_bridge/reset_scene"/>
    <param name="boundary_topic"
           value="$(arg navigation_boundary_topic)"/>
    <param name="odom_topic" value="/odom"/>
    <param name="move_base_status_topic" value="/move_base/status"/>
    <param name="current_goal_topic" value="/move_base/current_goal"/>
    <param name="cancel_topic" value="/move_base/cancel"/>
    <param name="resume_goal_topic" value="/move_base_simple/goal"/>
    <param name="command_topic"
           value="/yellow_track_avoidance/passage_cmd_vel"/>
    <param name="move_base_cmd_topic"
           value="/yellow_track_avoidance/move_base_cmd_vel"/>
    <param name="status_topic"
           value="/yellow_track_avoidance/passage/status"/>
    <param name="marker_topic"
           value="/yellow_track_avoidance/passage/markers"/>
  </node>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="rviz"
        output="screen" args="-d $(arg rviz_config)"/>

  <node if="$(arg start_perception_views)"
        pkg="rqt_image_view" type="rqt_image_view"
        name="yellow_track_raw_view" output="screen"
        args="/yellow_track_avoidance/debug/raw_overlay"/>

  <node if="$(arg start_perception_views)"
        pkg="rqt_image_view" type="rqt_image_view"
        name="yellow_track_plan_view" output="screen"
        args="/yellow_track_avoidance/debug/plan"/>
</launch>
