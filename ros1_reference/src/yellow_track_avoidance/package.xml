<?xml version="1.0"?>
<package format="2">
  <name>yellow_track_avoidance</name>
  <version>0.1.0</version>
  <description>OpenCV yellow-track following and red-white disk avoidance for ROS1 mobile robots.</description>

  <maintainer email="mo-bit@todo.todo">mo-bit</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>python3-setuptools</build_depend>

  <depend>actionlib_msgs</depend>
  <depend>costmap_converter</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>map_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>amcl</exec_depend>
  <exec_depend>car_bringup</exec_depend>
  <exec_depend>camera_info_manager</exec_depend>
  <exec_depend>lslidar_driver</exec_depend>
  <exec_depend>mowen</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>nav_demo</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>robot_localization</exec_depend>
