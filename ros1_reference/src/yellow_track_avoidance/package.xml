  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosservice</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>sbpl_lattice_planner</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>v4l-utils</exec_depend>
  <exec_depend>yesense_imu</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>python3-nose</test_depend>

  <export/>
</package>
