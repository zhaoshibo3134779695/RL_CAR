<launch>
  <!-- XY 平移路径跟随节点 -->
  <arg name="csv_name" default="ros_path.csv" />

  <node pkg="xy_path_follower"
        type="xy_path_follower"
        name="xy_path_follower"
        output="screen">

    <!-- 在 launch 里拼出完整路径传给 cpp 的 csv_path 参数 -->
    <param name="csv_path"
           value="$(find xy_path_follower)/path/$(arg csv_name)" />


    <!-- 下面这些参数按需要覆盖（可以不写，使用代码中的默认值） -->
    <!--
    <param name="rate"           value="20.0" />
    <param name="lookahead"      value="0.35" />
    <param name="goal_xy_tol"    value="0.05" />
    <param name="slow_down_dist" value="0.8" />

    <param name="vxy_max"        value="0.35" />
    <param name="k_xy"           value="0.7" />

    <param name="frame_map"      value="map" />
    <param name="frame_base"     value="base_link" />
    -->
    <remap from="/cmd_vel"   to="/xy_vel" />

  </node>
</launch>
