<launch>
    <!-- PID 参数 -->
    <arg name="kp"  default="1.5" />
    <arg name="ki"  default="0.0" />
    <arg name="kd"  default="0.1" />
    <arg name="max_ang_vel" default="1.0" />

    <!-- 坐标系 -->
    <arg name="world_frame" default="map" />
    <arg name="base_frame"  default="base_link" />

    <!-- 控制频率 -->
    <arg name="control_rate" default="50.0" />

    <node pkg="xy_path_follower"
          type="yaw_pid_controller"
          name="yaw_pid_controller"
          output="screen">

        <param name="kp" value="$(arg kp)" />
        <param name="ki" value="$(arg ki)" />
        <param name="kd" value="$(arg kd)" />
        <param name="max_ang_vel" value="$(arg max_ang_vel)" />

        <param name="world_frame" value="$(arg world_frame)" />
        <param name="base_frame"  value="$(arg base_frame)" />
        <param name="control_rate" value="$(arg control_rate)" />

        <!-- 如果你后来想重映射话题，也可以在这里加 remap -->
        <!--
        <remap from="/xy_vel"    to="/your_xy_vel_topic" />
        <remap from="/cmd_vel"   to="/your_cmd_vel_topic" />
        <remap from="/target_yaw" to="/your_target_yaw_topic" />
        -->
	<remap from="/cmd_vel"   to="/move_vision" />

    </node>
</launch>
